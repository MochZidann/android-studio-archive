<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"z
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">
    <EditText
        android:id="@+id/edHasil"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:ems="10"
        android:hint="@string/hintEt"
        android:inputType="textPersonName"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:text="@string/detik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnDetik"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toStartOf="@+id/btnGallery"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/edHasil"
        app:layout_constraintHorizontal_chainStyle="spread_inside"/>
    <Button
        android:text="@string/galeri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnGallery"
        app:layout_constraintStart_toEndOf="@+id/btnDetik"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toStartOf="@+id/btnPerkalian"
        app:layout_constraintTop_toTopOf="@+id/btnDetik"/>
    <Button
        android:text="@string/kali"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnPerkalian"
        app:layout_constraintStart_toEndOf="@+id/btnGallery"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@+id/btnGallery"/>
</androidx.constraintlayout.widget.ConstraintLayout>