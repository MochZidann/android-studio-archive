<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Tugas03" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="android:datePickerDialogTheme">@style/CustomPickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/CustomPickerDialog</item>
    </style>

    <style name="CustomPickerDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/blue</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogBlueButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogBlueButton</item>
    </style>

    <style name="DialogBlueButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>