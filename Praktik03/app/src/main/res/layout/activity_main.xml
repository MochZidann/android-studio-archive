<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="30dp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnDp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="@string/dPicker"
        app:layout_constraintEnd_toStartOf="@+id/btnTp1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:text="@string/tPicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnTp1"
        app:layout_constraintStart_toEndOf="@+id/btnDp1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnDp1"/>
    <Button
        android:text="@string/dpDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnDpd1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toStartOf="@+id/btnTpd1"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/btnDp1"/>
    <Button
        android:text="@string/tpDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnTpd1"
        app:layout_constraintStart_toEndOf="@+id/btnDpd1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnDpd1"/>
    <TextView
        android:text="@string/jamTanggal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txDateTime"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/btnDpd1"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"/>
    <DatePicker
        android:id="@+id/dp1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txDateTime">
    </DatePicker>
    <TimePicker
        android:id="@+id/tp1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txDateTime">
    </TimePicker>
</androidx.constraintlayout.widget.ConstraintLayout>